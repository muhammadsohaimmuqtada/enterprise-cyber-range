# enterprise-cyber-range environment
# Copy to .env in the repo root:  cp .env.example .env

# dc01 administrator password. Used by the domain provision, the workstation
# domain joins, and the purple-team walkthroughs. Keep the quotes: the value
# contains '#'.
DC_ADMIN_PASS="Lab-Admin#2026!"

# 0 = hardened portal (login bypass and /console are disabled; phases 1, 3-7
# still work). 1 = mount the simulated auth bypass and the /console dev shell
# (required for phases 2-7). After editing, recreate the service:
#   docker compose up -d web01
WEAK_AUTH=0
